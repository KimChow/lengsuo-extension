{
  "manifest_version": 3,
  "name": "Lengsuo Credential",
  "version": "0.1.0",
  "description": "凭据托管扩展：Passkey / 密码 / TOTP 的注入与桥接",
  "minimum_chrome_version": "120",

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content/fido2_content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*/*"],
      "js": ["content/password_content.js", "content/twostep_content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["main_world/fido2_page_script.js"],
      "matches": ["https://*/*"]
    }
  ],

  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging"
  ],

  "host_permissions": [
    "https://*/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
